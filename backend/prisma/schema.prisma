generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Brew {
  id           Int        @id @default(autoincrement())
  beans        String
  method       BrewMethod
  coffeeGrams  Int
  waterGrams   Int
  rating       Int
  tastingNotes String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("brews")
}

enum BrewMethod {
  AEROPRESS
  DRIP_COFFEE
  V60
  FRENCH_PRESS
  ESPRESSO
  MOKA_POT
  COLD_BREW
  CHEMEX
}
